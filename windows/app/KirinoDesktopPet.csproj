<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Version>1.2.0</Version>
    <UseWPF>true</UseWPF>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>KirinoDesktopPet</AssemblyName>
    <RootNamespace>KirinoDesktopPet</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>assets\kirino.ico</ApplicationIcon>
    <KirinoPythonCommand Condition="'$(KirinoPythonCommand)' == ''">python</KirinoPythonCommand>
    <PetAssetDirectory>$(BaseIntermediateOutputPath)kirino-assets\</PetAssetDirectory>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KirinoDesktopPet.Qa" />
    <PetAssetInput Include="..\assets\spritesheet.webp;..\assets\laptop-thinking.webp;..\assets\classic-jump.webp" />
    <PetAssetOutput Include="$(PetAssetDirectory)spritesheet.png;$(PetAssetDirectory)laptop-typing.png;$(PetAssetDirectory)laptop-thinking.png;$(PetAssetDirectory)waiting.png;$(PetAssetDirectory)review.png;$(PetAssetDirectory)hug.png;$(PetAssetDirectory)jumping.png;$(PetAssetDirectory)failed.png;$(PetAssetDirectory)timings.json" />
    <None Include="@(PetAssetOutput)" Link="assets\%(Filename)%(Extension)">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="assets\kirino.ico">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

  <Target Name="PreparePetAssets" BeforeTargets="PrepareForBuild" Condition="'$(DesignTimeBuild)' != 'true'"
          Inputs="prepare-assets.py;motion_art.py;@(PetAssetInput)" Outputs="@(PetAssetOutput)">
    <Exec Command="$(KirinoPythonCommand) &quot;prepare-assets.py&quot; &quot;$(PetAssetDirectory).&quot;" />
  </Target>
</Project>
