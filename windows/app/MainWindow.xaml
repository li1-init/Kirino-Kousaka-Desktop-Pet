<Window x:Class="KirinoDesktopPet.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        Width="192"
        Height="208"
        Title="高坂桐乃 Chibi"
        PreviewMouseRightButtonDown="Window_OnPreviewMouseRightButtonDown"
        PreviewMouseRightButtonUp="Window_OnPreviewMouseRightButtonUp">
    <Grid Background="Transparent">
        <Image x:Name="PetImage"
               Stretch="Uniform"
               SnapsToDevicePixels="True"
               RenderOptions.BitmapScalingMode="HighQuality"
               MouseLeftButtonDown="PetImage_OnMouseLeftButtonDown"
               MouseRightButtonUp="PetImage_OnMouseRightButtonUp" />
    </Grid>
</Window>
